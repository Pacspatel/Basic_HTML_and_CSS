```css
/* Smooth scrolling */
html {
    scroll-behavior: smooth;
}

/* About Section */
#about {
    padding: 40px;
    text-align: center;
}

#about h2 {
    font-size: 30px;
    margin-bottom: 20px;
}

#about div {
    max-width: 800px;
    margin: auto;
    line-height: 1.6;
    font-size: 18px;
}